# React 19 is newer than some plugins' declared peer ranges (notably
# eslint-plugin-react-hooks@7 only goes up to eslint 9, but we're on
# eslint 10). The conflicts are benign — the plugins work fine at the
# runtime API — but `npm install` / `npm ci` refuse to resolve without
# this flag. Setting it here so CI (Cloudflare Pages build) and fresh
# local installs don't need to remember --legacy-peer-deps.
legacy-peer-deps=true
